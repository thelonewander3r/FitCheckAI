YOUCAM_MODE=mock
# YOUCAM_MODE=live

# Optional event-context research. Mock venue lookup remains the default.
# VENUE_MODE=openai
# OPENAI_API_KEY=
# OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini

# Required when YOUCAM_MODE=live — obtain from Perfect Corp / YouCam credentials
YOUCAM_API_KEY=
# Official Perfect Corp YCE host (override only if docs specify another region)
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Optional live tuning
# YOUCAM_TIMEOUT_MS=120000
# YOUCAM_POLL_INTERVAL_MS=1500
# Comma-separated SD skin actions only (do not mix with hd_*): texture,pore,redness,radiance
# YOUCAM_SKIN_ACTIONS=texture,pore,redness,radiance

DATABASE_URL="file:./dev.db"

# Prototype: temporary upload directory (not permanent object storage)
UPLOAD_TEMP_DIR=./uploads/tmp

# Persistence backend. Omit for auto-detect:
#   next dev / Node  → fs (.data/*.json + uploads/tmp)
#   Cloudflare Workers → KV (FITCHECK_KV) + R2 (FITCHECK_R2)
#   vitest            → memory (set in vitest.config.mts)
# FITCHECK_STORAGE=fs
# FITCHECK_STORAGE=cloudflare
# FITCHECK_STORAGE=memory
